<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema normal de la aplicación -->
    <style name="Theme.EcoRuta" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Tema utilizado mientras Android inicia la aplicación -->
    <style name="Theme.EcoRuta.Splash" parent="Theme.SplashScreen">

        <!-- Color de fondo de la Splash -->
        <item name="windowSplashScreenBackground">@color/ecoruta_primary</item>

        <!-- Logo mostrado durante el arranque. Lienzo de 288dp con el logo de 145dp centrado
             (mismo tamaño y posición que el primer fotograma del Splash de Compose). -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_native</item>

        <!-- Tema que se utilizará después del Splash -->
        <item name="postSplashScreenTheme">@style/Theme.EcoRuta</item>

    </style>

</resources>